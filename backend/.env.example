# ==============================================================================
# Lumière Jewels / TVISA Backend Environment Variables Template
# Copy this file to '.env' in the backend directory and update the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# Set to 'config.settings.development' for local dev or 'config.settings.production' for prod
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret key for Django cryptographic signing. Generate a strong random key in production!
SECRET_KEY=django-insecure-change-this-secret-key-for-production-use

# Debug mode (True for development, False for production)
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1


# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Database URL (PostgreSQL format: postgres://user:password@host:5432/dbname)
# Leave empty or omit in development to automatically default to SQLite (db.sqlite3)
DATABASE_URL=
RDS_DATABASE_URL=


# ------------------------------------------------------------------------------
# 3. CORS & Frontend Integration
# ------------------------------------------------------------------------------
# Comma-separated allowed origin URLs for CORS (Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the frontend application (used in transactional emails & revalidation)
FRONTEND_URL=http://localhost:3000

# Base URL of the backend API (used for constructing admin panel links in emails)
BACKEND_URL=http://localhost:8000

# Shared secret key matching Next.js REVALIDATION_SECRET for On-Demand ISR cache invalidation
REVALIDATION_SECRET=your-nextjs-revalidation-secret-key


# ------------------------------------------------------------------------------
# 4. Authentication / SimpleJWT
# ------------------------------------------------------------------------------
# Access token expiration time in minutes (default is 15)
JWT_ACCESS_TOKEN_LIFETIME=15


# ------------------------------------------------------------------------------
# 5. Transactional Email (Resend)
# ------------------------------------------------------------------------------
# Resend API Key (re_...) for sending transactional emails (Order confirmation, OTPs, etc.)
RESEND_API_KEY=re_your_resend_api_key_here

# Default sender email address
DEFAULT_FROM_EMAIL=noreply@xiphora.tech


# ------------------------------------------------------------------------------
# 6. Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# ------------------------------------------------------------------------------
# 7. WhatsApp & SMS Service (Twilio)
# ------------------------------------------------------------------------------
# Twilio Account SID & Auth Token for sending WhatsApp OTPs and notification messages
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio WhatsApp sender number (e.g. +14155238886)
TWILIO_WHATSAPP_NUMBER=+14155238886


# ------------------------------------------------------------------------------
# 8. AWS S3 Storage & CloudFront CDN
# ------------------------------------------------------------------------------
# AWS S3 credentials for uploading & hosting media files (product images, banners)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION_NAME=ap-south-1

# Optional subfolder inside S3 bucket (e.g., 'media' or leave empty)
AWS_LOCATION=

# Optional CloudFront CDN domain (e.g., d123456.cloudfront.net)
AWS_CLOUDFRONT_DOMAIN=

# AWS S3 Configuration Defaults
AWS_QUERYSTRING_AUTH=False
AWS_S3_FILE_OVERWRITE=False
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_CACHE_CONTROL=max-age=31536000, public


# ------------------------------------------------------------------------------
# 9. Production Security (Optional for Production environment)
# ------------------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS in production
SECURE_SSL_REDIRECT=False


# ------------------------------------------------------------------------------
# 10. Migration Scripts (Optional)
# ------------------------------------------------------------------------------
# Required only if running 'python manage.py migrate_cloudinary_to_s3'
CLOUDINARY_CLOUD_NAME=
